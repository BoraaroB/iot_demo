{
  "name": "autonomous-vehicle-iot",
  "private": true,
  "version": "0.1.0",
  "description": "Production-style Industrial IoT platform for monitoring autonomous factory vehicles.",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "typecheck": "tsc --build tsconfig.json",
    "clean": "tsc --build tsconfig.json --clean",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "typescript": "^6.0.3",
    "eslint": "^10.11.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.70.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
