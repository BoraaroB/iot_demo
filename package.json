{
  "name": "autonomous-vehicle-iot",
  "private": true,
  "version": "0.1.0",
  "description": "Production-style Industrial IoT platform for monitoring autonomous factory vehicles.",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "typecheck": "tsc --build tsconfig.json",
    "clean": "tsc --build tsconfig.json --clean",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node scripts/smoke.mjs",
    "smoke:kafka": "node scripts/smoke-kafka.mjs",
    "smoke:ingestion": "node scripts/smoke-ingestion.mjs",
    "smoke:telemetry": "node scripts/smoke-telemetry.mjs",
    "smoke:simulator": "node scripts/smoke-simulator.mjs",
    "smoke:e2e": "node scripts/smoke-e2e.mjs",
    "simulate": "node services/simulator/dist/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "kafkajs": "^2.2.4",
    "mqtt": "^5.16.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
